{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orquestador",
  "permissions": [
    { "action": "*", "resource": "*", "effect": "allow" },

    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "edit", "resource": "*.env", "effect": "deny" },
    { "action": "edit", "resource": "*.env.*", "effect": "deny" },
    { "action": "edit", "resource": "*.env.example", "effect": "allow" },

    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "rm *", "effect": "ask" },
    { "action": "shell", "resource": "rm -rf *", "effect": "deny" },
    { "action": "shell", "resource": "rm -fr *", "effect": "deny" },
    { "action": "shell", "resource": "rm -r *", "effect": "deny" },
    { "action": "shell", "resource": "find * -delete*", "effect": "deny" },
    { "action": "shell", "resource": "xargs rm*", "effect": "deny" },
    { "action": "shell", "resource": "truncate *", "effect": "deny" },
    { "action": "shell", "resource": "dd *", "effect": "deny" },
    { "action": "shell", "resource": "mkfs*", "effect": "deny" },
    { "action": "shell", "resource": "shutdown*", "effect": "deny" },
    { "action": "shell", "resource": "reboot*", "effect": "deny" },
    { "action": "shell", "resource": "sudo *", "effect": "deny" },
    { "action": "shell", "resource": "chown *", "effect": "deny" },
    { "action": "shell", "resource": "chmod *", "effect": "ask" },
    { "action": "shell", "resource": "ssh *", "effect": "deny" },
    { "action": "shell", "resource": "scp *", "effect": "deny" },
    { "action": "shell", "resource": "nc *", "effect": "deny" },

    { "action": "shell", "resource": "git push *", "effect": "deny" },
    { "action": "shell", "resource": "git reset --hard *", "effect": "deny" },
    { "action": "shell", "resource": "git clean *", "effect": "deny" },
    { "action": "shell", "resource": "git checkout -- *", "effect": "deny" },
    { "action": "shell", "resource": "git restore *", "effect": "deny" },
    { "action": "shell", "resource": "git stash drop*", "effect": "deny" },
    { "action": "shell", "resource": "git branch -D*", "effect": "deny" },
    { "action": "shell", "resource": "git commit *", "effect": "ask" },
    { "action": "shell", "resource": "git tag *", "effect": "ask" },
    { "action": "shell", "resource": "git * --no-verify*", "effect": "deny" },

    { "action": "shell", "resource": "cat *.env*", "effect": "deny" },
    { "action": "shell", "resource": "head *.env*", "effect": "deny" },
    { "action": "shell", "resource": "tail *.env*", "effect": "deny" },
    { "action": "shell", "resource": "less *.env*", "effect": "deny" },
    { "action": "shell", "resource": "more *.env*", "effect": "deny" },
    { "action": "shell", "resource": "strings *.env*", "effect": "deny" },
    { "action": "shell", "resource": "xxd *.env*", "effect": "deny" },
    { "action": "shell", "resource": "source *.env*", "effect": "deny" },
    { "action": "shell", "resource": "grep * .env*", "effect": "deny" },
    { "action": "shell", "resource": "grep */.env*", "effect": "deny" },
    { "action": "shell", "resource": "sed * .env*", "effect": "deny" },
    { "action": "shell", "resource": "awk * .env*", "effect": "deny" },
    { "action": "shell", "resource": "printenv*", "effect": "deny" },
    { "action": "shell", "resource": "env", "effect": "deny" },

    { "action": "shell", "resource": "curl *", "effect": "ask" },
    { "action": "shell", "resource": "wget *", "effect": "ask" },
    { "action": "shell", "resource": "npm install *", "effect": "ask" },
    { "action": "shell", "resource": "npm ci *", "effect": "ask" },
    { "action": "shell", "resource": "npm uninstall *", "effect": "ask" },
    { "action": "shell", "resource": "pip install *", "effect": "ask" },
    { "action": "shell", "resource": "pip uninstall *", "effect": "ask" },
    { "action": "shell", "resource": "uv add *", "effect": "ask" },
    { "action": "shell", "resource": "uv remove *", "effect": "ask" },
    { "action": "shell", "resource": "brew *", "effect": "ask" },

    { "action": "shell", "resource": "supabase db reset*", "effect": "ask" },
    { "action": "shell", "resource": "supabase db push*", "effect": "ask" },
    { "action": "shell", "resource": "make db-reset*", "effect": "ask" },
    { "action": "shell", "resource": "make cutover", "effect": "ask" },
    { "action": "shell", "resource": "make cutover-dry*", "effect": "allow" },
    { "action": "shell", "resource": "make restore-drill*", "effect": "ask" },
    { "action": "shell", "resource": "*cutover_legacy.py*", "effect": "ask" },
    { "action": "shell", "resource": "*cutover_legacy.py --dry-run*", "effect": "allow" },
    { "action": "shell", "resource": "psql *", "effect": "ask" },
    { "action": "shell", "resource": "pg_restore *", "effect": "ask" },
    { "action": "shell", "resource": "docker *", "effect": "ask" },
    { "action": "shell", "resource": "docker ps *", "effect": "allow" },

    { "action": "edit", "resource": "supabase/migrations/*", "effect": "ask" },

    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "webfetch", "resource": "*", "effect": "ask" },
    { "action": "websearch", "resource": "*", "effect": "ask" },
    { "action": "browser", "resource": "*", "effect": "deny" },
    { "action": "skill", "resource": "browser", "effect": "deny" }
  ]
}
