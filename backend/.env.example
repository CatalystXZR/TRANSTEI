# Copiar a .env y completar con los datos del proyecto Supabase
# Proyecto: https://supabase.com/dashboard → Settings → API

# URL del proyecto Supabase (ej: https://abcdefgh.supabase.co)
SUPABASE_URL=
# Clave anónima (solo referencia; el backend no la usa para auth)
SUPABASE_ANON_KEY=
# Clave service_role (nunca exponer en frontend)
SUPABASE_SERVICE_ROLE_KEY=
# Secreto JWT (Settings → API → JWT Settings)
SUPABASE_JWT_SECRET=

# Conexión PostgreSQL de Supabase (Settings → Database → Connection string → Session pooler)
DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# DEBUG debe permanecer en false. Activarlo solo en desarrollo local y nunca con
# datos reales: el engine registra cada consulta SQL (con parámetros) en stdout.
DEBUG=false
CORS_ORIGINS=http://localhost:3000

# Opcional: base PostgreSQL dedicada a tests de integración del núcleo v2.
# Debe tener aplicada supabase/migrations/0004_nucleo_operacional.sql.
NUCLEO_TEST_DATABASE_URL=

# --- Agentes conversacionales (Ola 3) ---
# NUNCA subas este archivo con claves reales. Las claves van SOLO en backend/.env,
# que está ignorado por git. Aquí solo se documentan los nombres.
# DeepSeek es compatible con la API de OpenAI: para otro proveedor cambia
# AGENTE_LLM_BASE_URL y los modelos.
AGENTE_LLM_PROVEEDOR=deepseek
AGENTE_LLM_BASE_URL=https://api.deepseek.com/v1
AGENTE_LLM_TIMEOUT_S=45
AGENTE_LLM_MAX_ITERACIONES=4
AGENTE_LLM_MAX_TOOL_CALLS=8
AGENTE_LLM_MAX_TOOL_CALLS_TURNO=16
AGENTE_LLM_MAX_MENSAJES_CONTEXTO=30
AGENTE_PLANES_PREMIUM=premium,pro
AGENTE_CHAT_MAX_CONCURRENT=4

# >>> PEGA TUS API KEYS EN backend/.env, NO EN ESTE ARCHIVO <<<
GERENTE_API_KEY=
SECRETARIA_API_KEY=
GERENTE_LLM_MODELO=deepseek-chat
SECRETARIA_LLM_MODELO=deepseek-chat
