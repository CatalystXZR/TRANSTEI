{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "despacho.viajes_del_dia entrada",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "fecha": { "type": "string", "format": "date" },
    "estado": {
      "type": "string",
      "enum": [
        "borrador",
        "cotizado",
        "confirmado",
        "asignado",
        "en_carga",
        "cargado",
        "en_ruta",
        "en_descarga",
        "descargado",
        "pod_pendiente",
        "cerrado",
        "facturado",
        "cobrado",
        "anulado"
      ]
    },
    "limite": { "type": "integer", "minimum": 1, "maximum": 100 }
  }
}
